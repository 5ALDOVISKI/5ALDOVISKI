{%- comment -%}
  Analytics & marketing tags — loaded asynchronously so they never block render.
  NOTE: For most stores, Shopify's built-in Google & Meta sales channels and
  Customer Events (Settings > Customer events / Custom pixels) are the preferred,
  consent-aware way to add tracking. These fields are provided for teams that
  manage tags directly. IDs are entered in Theme settings > Analytics & marketing.
{%- endcomment -%}

{%- if settings.ga4_measurement_id != blank -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id | escape }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', {{ settings.ga4_measurement_id | json }});
  </script>
{%- endif -%}

{%- if settings.meta_pixel_id != blank -%}
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', {{ settings.meta_pixel_id | json }});
    fbq('track', 'PageView');
  </script>
{%- endif -%}

