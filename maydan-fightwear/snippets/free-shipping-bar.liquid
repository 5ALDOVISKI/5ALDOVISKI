{%- comment -%}
  Free-shipping progress bar. Display-only; configure the real rate in
  Settings > Shipping. Accepts nothing — reads cart + settings.
{%- endcomment -%}
{%- if settings.cart_show_free_shipping_bar and settings.cart_free_shipping_threshold > 0 -%}
  {%- assign threshold = settings.cart_free_shipping_threshold | times: 100 -%}
  {%- assign remaining = threshold | minus: cart.total_price -%}
  {%- assign qualified = false -%}
  {%- if remaining <= 0 -%}{%- assign qualified = true -%}{%- endif -%}
  {%- assign pct = cart.total_price | times: 100.0 | divided_by: threshold -%}
  {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
  <div class="free-shipping-bar {% if qualified %}free-shipping-bar--complete{% endif %}" data-free-shipping-bar>
    <p class="free-shipping-bar__text">
      {%- if qualified -%}
        {{ 'sections.cart.free_shipping_qualified' | t }}
      {%- else -%}
        {%- capture amount_html -%}<strong>{{ remaining | money }}</strong>{%- endcapture -%}
        {{ 'sections.cart.free_shipping_progress' | t: amount: amount_html }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct | round }}">
      <span class="free-shipping-bar__fill" style="width: {{ pct }}%;"></span>
    </div>
  </div>
{%- endif -%}
