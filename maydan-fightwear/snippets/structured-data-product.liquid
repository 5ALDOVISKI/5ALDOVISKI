{%- comment -%}
  Product JSON-LD for rich results + Google Merchant Center.
  Offers are generated per variant with real availability. No fabricated ratings.
  Accepts: product.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_media -%}
  "image": [
    {%- for media in product.media limit: 5 -%}
      {%- if media.preview_image -%}
        {{ media.preview_image | image_url: width: 1200 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  "description": {{ product.description | default: product.title | strip_html | json }},
  {%- if product.vendor != blank -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- else -%}
  "brand": {
    "@type": "Brand",
    "name": {{ shop.name | json }}
  },
  {%- endif -%}
  {%- assign sku_variant = product.selected_or_first_available_variant -%}
  {%- if sku_variant.sku != blank -%}
  "sku": {{ sku_variant.sku | json }},
  {%- endif -%}
  {%- if product.metafields.custom.country_of_manufacture != blank -%}
  "countryOfOrigin": {{ product.metafields.custom.country_of_manufacture | json }},
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
