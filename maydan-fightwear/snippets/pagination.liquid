{%- comment -%} Accessible numbered pagination. Accepts: paginate. {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="collection-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination-list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination-list__item" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
            {% render 'icon', icon: 'chevron-left', size: 16 %}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination-list__item" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="pagination-list__item" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
            {%- else -%}
              <span class="pagination-list__item">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a class="pagination-list__item" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
            {% render 'icon', icon: 'chevron-right', size: 16 %}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
