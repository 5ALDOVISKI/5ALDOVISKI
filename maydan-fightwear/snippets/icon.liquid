{%- comment -%}
  Inline SVG icon system. Usage: {% render 'icon', icon: 'bag' %}
  Optional: class, size (px). All icons use currentColor.
{%- endcomment -%}
{%- liquid
  assign s = 24
  if size
    assign s = size
  endif
-%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg class="icon icon-search {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon-account {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
  {%- when 'bag' -%}
    <svg class="icon icon-bag {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'menu' -%}
    <svg class="icon icon-menu {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
