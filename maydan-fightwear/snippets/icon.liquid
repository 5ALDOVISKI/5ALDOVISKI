  {%- when 'facebook' -%}
    <svg class="icon icon-facebook {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 8h2V5h-2c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V8.7c0-.4.3-.7.7-.7z"/></svg>
  {%- when 'stretch' -%}
    <svg class="icon {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M4 12h16M4 12l3-3M4 12l3 3M20 12l-3-3M20 12l-3 3M12 4v16M12 4L9 7M12 4l3 3M12 20l-3-3M12 20l3-3"/></svg>
  {%- when 'seam' -%}
    <svg class="icon {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M4 8h16M4 16h16"/><path d="M6 8v-.01M10 8v-.01M14 8v-.01M18 8v-.01M6 16v-.01M10 16v-.01M14 16v-.01M18 16v-.01" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'hem' -%}
    <svg class="icon {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M5 6v9a7 3 0 0 0 14 0V6"/><path d="M5 6a7 3 0 0 1 14 0"/></svg>
  {%- when 'movement' -%}
