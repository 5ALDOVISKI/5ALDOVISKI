  {%- when 'chevron-down' -%}
    <svg class="icon icon-chevron-down {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="icon icon-chevron-left {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="icon icon-chevron-right {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
  {%- when 'arrow-right' -%}
