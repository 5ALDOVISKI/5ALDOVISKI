{% # theme-check-disable RemoteAsset %}
{%- comment -%}
  Body-level analytics fallbacks (noscript pixels). Rendered right after <body>.
  RemoteAsset disabled: the Meta noscript pixel must load from facebook.com.
{%- endcomment -%}
{%- if settings.meta_pixel_id != blank -%}
  <noscript>
    <img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id | escape }}&ev=PageView&noscript=1">
  </noscript>
{%- endif -%}
