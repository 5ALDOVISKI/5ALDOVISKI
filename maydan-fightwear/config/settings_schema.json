  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headings_header"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "t:settings.typography.heading_font.label",
        "info": "t:settings.typography.heading_font.info",
        "default": "archivo_n7"
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "t:settings.typography.heading_uppercase.label",
        "default": true
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -2,
        "max": 8,
        "step": 0.5,
        "unit": "px",
        "label": "t:settings.typography.heading_letter_spacing.label",
        "default": 1
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 160,
        "step": 5,
        "unit": "%",
        "label": "t:settings.typography.heading_scale.label",
        "default": 120
      },
      {
        "type": "header",
        "content": "t:settings.typography.body_header"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "t:settings.typography.body_font.label",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:settings.typography.body_scale.label",
        "default": 100
      }
    ]
  },
  {
