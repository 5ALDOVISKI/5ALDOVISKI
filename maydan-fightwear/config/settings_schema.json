[
  {
    "name": "theme_info",
    "theme_name": "MAYDAN Fightwear",
    "theme_version": "1.0.0",
    "theme_author": "MAYDAN",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "t:settings.logo.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.logo.logo.label",
        "info": "t:settings.logo.logo.info"
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "t:settings.logo.logo_light.label",
        "info": "t:settings.logo.logo_light.info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "t:settings.logo.logo_width.label",
        "default": 150
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "t:settings.logo.logo_width_mobile.label",
        "default": 110
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.logo.favicon.label",
        "info": "t:settings.logo.favicon.info"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.colors.background.label",
            "default": "#090909"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings.colors.background_gradient.label",
            "info": "t:settings.colors.background_gradient.info"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings.colors.text.label",
            "default": "#EEE9DF"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button.label",
            "default": "#A31E27"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label.label",
            "default": "#EEE9DF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings.colors.secondary_button_label.label",
            "default": "#EEE9DF"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:settings.colors.shadow.label",
            "default": "#000000"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      },
      {
        "type": "header",
        "content": "t:settings.colors.brand_accents_header"
      },
      {
        "type": "paragraph",
        "content": "t:settings.colors.brand_accents_info"
      },
      {
        "type": "color",
        "id": "accent_red",
        "label": "t:settings.colors.accent_red.label",
        "info": "t:settings.colors.accent_red.info",
        "default": "#A31E27"
      },
      {
        "type": "color",
        "id": "accent_bone",
        "label": "t:settings.colors.accent_bone.label",
        "default": "#EEE9DF"
      },
      {
        "type": "color",
        "id": "accent_grey",
        "label": "t:settings.colors.accent_grey.label",
        "default": "#A7A39B"
      }
    ]
