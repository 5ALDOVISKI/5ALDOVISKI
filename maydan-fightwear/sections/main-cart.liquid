{%- comment -%}
  Full cart page for customers who prefer the standard cart experience.
  Updates line items without a full refresh (cart-items custom element).
{%- endcomment -%}
<div class="page-width cart-page color-{{ section.settings.color_scheme }}">
  <cart-items data-cart-main>
    {%- if cart == empty -%}
      <div class="cart-empty-state">
        <h1 class="cart-empty-state__title h1">{{ 'sections.cart.empty' | t }}</h1>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <h1 class="cart-page__title h1">{{ 'sections.cart.title' | t }}</h1>
      <div class="cart-page__grid">
        <form action="{{ routes.cart_url }}" method="post" id="cart-page-form" class="cart-page__items">
          <div class="cart-table">
            {%- for item in cart.items -%}
              {%- render 'cart-line-item', item: item, context: 'page' -%}
            {%- endfor -%}
          </div>
          {%- if settings.cart_show_note -%}
            <div style="margin-top:2rem;">
              <label class="field__label" for="cart-note">{{ 'sections.cart.note' | t }}</label>
              <textarea id="cart-note" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </form>

        <aside class="cart-summary" aria-label="Order summary">
          {%- render 'free-shipping-bar' -%}
          <div class="cart-summary__row" style="margin-top:1.6rem;">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row cart-item__discount">
              <span>{{ discount.title }}</span>
              <span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row cart-summary__total">
            <span>{{ 'sections.cart.estimated_total' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__tax-note">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
          <button type="submit" name="checkout" form="cart-page-form" class="button button--full">{{ 'sections.cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div class="cart__dynamic-checkout additional-checkout-buttons" style="margin-top:1rem;">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}" class="button button--secondary button--full" style="margin-top:1rem;">{{ 'sections.cart.continue_shopping' | t }}</a>
        </aside>
      </div>
    {%- endif -%}
  </cart-items>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Black" },
        { "value": "scheme-2", "label": "Bone" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
