{%- comment -%} Password / coming-soon page. Uses password.liquid layout. {%- endcomment -%}
<div class="hero hero--full color-scheme-1" style="align-items:center;">
  {%- if section.settings.background_image != blank -%}
    <div class="hero__media">{{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'eager', alt: shop.name | escape }}</div>
    <div class="hero__overlay" style="opacity:1;"></div>
  {%- else -%}
    <div class="hero__placeholder"></div>
  {%- endif -%}
  <div class="hero__content" style="padding-bottom:0;text-align:center;">
    <div class="hero__inner hero__inner--center">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" style="width:200px;height:auto;margin:0 auto 3rem;">
      {%- else -%}
        <p class="header__logo-text" style="font-size:4rem;margin-bottom:2rem;">MAYDAN</p>
      {%- endif -%}
      <h1 class="hero__title" style="font-size:clamp(3rem,7vw,6rem);">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__subtitle" style="margin-left:auto;margin-right:auto;">{{ section.settings.text | escape }}</p>{%- endif -%}

      {%- form 'customer', class: 'newsletter-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <div class="newsletter-form__field field">
          <label class="visually-hidden" for="password-email">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
          <input id="password-email" type="email" name="contact[email]" required placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" autocomplete="email">
        </div>
        <button type="submit" class="button">{{ 'general.newsletter_form.submit' | t }}</button>
        {%- if form.posted_successfully? -%}<p class="newsletter-form__message form__message--success" style="justify-content:center;">{{ 'general.newsletter_form.confirmation' | t }}</p>{%- endif -%}
      {%- endform -%}

      <div style="margin-top:3rem;">
        {%- render 'social-icons' -%}
      </div>

      <details style="margin-top:2rem;">
        <summary class="link-underline" style="cursor:pointer;list-style:none;display:inline-block;">{{ 'general.password_page.login_form_heading' | t }}</summary>
        <div style="margin-top:1.6rem;max-width:36rem;margin-left:auto;margin-right:auto;">
          {%- form 'storefront_password' -%}
            {%- if form.errors -%}<p class="form__message form__message--error">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
            <div class="newsletter-form">
              <div class="newsletter-form__field field">
                <label class="visually-hidden" for="store-password">{{ 'general.password_page.login_form_password_label' | t }}</label>
                <input type="password" id="store-password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
              </div>
              <button type="submit" class="button">{{ 'general.password_page.login_form_submit' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ENTER THE MAYDAN." },
    { "type": "text", "id": "text", "label": "Text", "default": "Drop 001 is coming. Join the list for first access." }
  ]
}
{% endschema %}
