{%- comment -%} All collections listing. {%- endcomment -%}
<div class="page-width color-{{ section.settings.color_scheme }}" style="padding-top:4rem;padding-bottom:6rem;">
  <header class="section-heading reveal">
    <h1 class="section-heading__title h1">{{ section.settings.heading | default: 'Collections' | escape }}</h1>
  </header>
  <div class="collection-list-grid">
    {%- assign collections_to_show = section.settings.collections_to_show -%}
    {%- for collection in collections limit: collections_to_show -%}
      {%- if collection.all_products_count > 0 or collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="category-tile reveal">
          <div class="category-tile__media">
            {%- if collection.image or collection.products.first.featured_media -%}
              {{ collection.image | default: collection.products.first.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width:750px) 33vw, 100vw', alt: collection.title | escape }}
            {%- else -%}
              <div class="category-tile__placeholder"></div>
            {%- endif -%}
          </div>
          <div class="category-tile__overlay"></div>
          <div class="category-tile__content">
            <h2 class="category-tile__title">{{ collection.title | escape }}</h2>
            <span class="category-tile__cta" aria-hidden="true">{% render 'icon', icon: 'arrow-right', size: 18 %}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Black" },
        { "value": "scheme-2", "label": "Bone" }
      ],
      "default": "scheme-1"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "collections_to_show", "min": 3, "max": 30, "step": 1, "label": "Collections to show", "default": 12 }
  ]
}
{% endschema %}
