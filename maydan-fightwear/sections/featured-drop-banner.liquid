{%- comment -%}
  Featured drop banner — wide campaign banner for a collection/drop.
  All text, image, alignment and link editable. Labeled placeholder when empty.
{%- endcomment -%}
{%- liquid
  assign align = section.settings.content_alignment
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section class="drop-banner color-scheme-1 section-spacing" data-section-id="{{ section.id }}">
  <div class="drop-banner__media">
    {%- if has_image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800,1200,1800,2400', sizes: '100vw', alt: section.settings.heading | escape, class: 'drop-banner__image' }}
    {%- else -%}
      <div class="drop-banner__placeholder"></div>
      <span class="placeholder-tag">Campaign banner image — replace in theme editor</span>
    {%- endif -%}
  </div>
  <div class="drop-banner__overlay drop-banner__overlay--{{ align }}"></div>
  <div class="drop-banner__content drop-banner__content--{{ align }}">
    <div class="drop-banner__inner">
      {%- if section.settings.overline != blank -%}
        <p class="overline reveal">{{ section.settings.overline | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="drop-banner__title reveal">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="drop-banner__text reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="reveal">
          <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured drop banner",
  "class": "section-drop-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image",
      "info": "Wide editorial photography. Landscape recommended."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "DROP 001"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MUHARIB"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Made for pressure. Cut for movement."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured drop banner"
    }
  ]
}
{% endschema %}
