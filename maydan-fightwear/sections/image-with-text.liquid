{%- comment -%} Image + text — brand story / editorial pairing. {%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="image-with-text {% if section.settings.layout == 'reverse' %}image-with-text--reverse{% endif %} reveal">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1200', sizes: '(min-width:750px) 50vw, 100vw', alt: section.settings.heading | escape }}
        {%- else -%}
          <div class="category-tile__placeholder"></div>
          <span class="placeholder-tag">Image — replace in theme editor</span>
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:2.4rem;"><a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label | escape }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Black" },
        { "value": "scheme-2", "label": "Bone" },
        { "value": "scheme-3", "label": "Charcoal" }
      ],
      "default": "scheme-1"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [ { "value": "normal", "label": "Left" }, { "value": "reverse", "label": "Right" } ],
      "default": "normal"
    },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the rounds that count" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Technical fabrics, disciplined construction and a fit made for pressure.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
