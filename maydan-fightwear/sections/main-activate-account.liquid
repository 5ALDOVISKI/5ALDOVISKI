{%- comment -%} Activate account. {%- endcomment -%}
<div class="page-width color-{{ section.settings.color_scheme }}" style="max-width:48rem;padding-top:5rem;padding-bottom:6rem;">
  <header class="text-center" style="margin-bottom:2rem;">
    <h1 class="h1">{{ 'customer.activate_account.title' | t }}</h1>
    <p style="margin-top:1rem;">{{ 'customer.activate_account.subtext' | t }}</p>
  </header>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <p class="form__message form__message--error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="field" style="flex-direction:column;align-items:flex-start;margin-bottom:1.6rem;">
      <label class="field__label" for="activate-password">{{ 'customer.activate_account.password' | t }}</label>
      <input type="password" id="activate-password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field" style="flex-direction:column;align-items:flex-start;margin-bottom:1.6rem;">
      <label class="field__label" for="activate-password-confirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input type="password" id="activate-password-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" name="commit" class="button button--full">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" name="decline" class="button button--secondary button--full" style="margin-top:1rem;">{{ 'customer.activate_account.cancel' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Activate account", "settings": [ { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [ { "value": "scheme-1", "label": "Black" }, { "value": "scheme-2", "label": "Bone" } ], "default": "scheme-1" } ] }
{% endschema %}
