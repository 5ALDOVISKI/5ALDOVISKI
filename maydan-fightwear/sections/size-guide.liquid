{%- comment -%}
  Size guide page. Editable charts + how-to-measure.
  The product page size-guide drawer shows this page's rich-text CONTENT; put a
  concise table there too (Admin > Pages), or link out to this fuller page.
{%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <header class="text-center reveal" style="margin-bottom:3rem;">
      {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline | escape }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading | default: 'Size guide' | escape }}</h1>
      {%- if section.settings.intro != blank -%}<div class="rte measure center-block" style="margin-top:1.4rem;">{{ section.settings.intro }}</div>{%- endif -%}
    </header>

    {%- if page.content != blank -%}
      <div class="rte reveal" style="margin-bottom:3rem;">{{ page.content }}</div>
    {%- endif -%}

    <div class="reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'chart' -%}
            <div class="size-chart" {{ block.shopify_attributes }} style="margin-bottom:3rem;">
              {%- if block.settings.title != blank -%}<h2 class="h3">{{ block.settings.title | escape }}</h2>{%- endif -%}
              <div class="rte">
                <table class="size-guide-table">{{ block.settings.table }}</table>
              </div>
            </div>
          {%- when 'measure' -%}
            <div class="how-to-measure" {{ block.shopify_attributes }} style="margin-bottom:3rem;">
              {%- if block.settings.title != blank -%}<h2 class="h3">{{ block.settings.title | escape }}</h2>{%- endif -%}
              <div class="rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [ { "value": "scheme-1", "label": "Black" }, { "value": "scheme-2", "label": "Bone" } ],
      "default": "scheme-1"
    },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>MAYDAN gear runs true to size with a compression fit. Measure and compare to the charts below.</p>" }
  ],
  "blocks": [
    {
      "type": "chart",
      "name": "Size chart",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Rashguards" },
        { "type": "richtext", "id": "table", "label": "Table rows", "info": "Paste your table markup or rows here.", "default": "<tr><th>Size</th><th>Chest (in)</th><th>Height (in)</th></tr><tr><td>S</td><td>36–38</td><td>5'6\"–5'9\"</td></tr><tr><td>M</td><td>38–40</td><td>5'9\"–6'0\"</td></tr><tr><td>L</td><td>40–43</td><td>6'0\"–6'2\"</td></tr>" }
      ]
    },
    {
      "type": "measure",
      "name": "How to measure",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How to measure" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>Chest:</strong> measure around the fullest part of your chest. <strong>Waist:</strong> measure around your natural waistline.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [ { "type": "chart" }, { "type": "measure" } ]
    }
  ]
}
{% endschema %}
