{%- comment -%} Generic app section — lets merchants add app blocks to any page. {%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- for block in section.blocks -%}
      {%- render block -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Apps",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [ { "value": "scheme-1", "label": "Black" }, { "value": "scheme-2", "label": "Bone" } ], "default": "scheme-1" }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Apps" } ]
}
{% endschema %}
