{%- comment -%} Order detail page. {%- endcomment -%}
<div class="page-width color-{{ section.settings.color_scheme }}" style="padding-top:4rem;padding-bottom:6rem;">
  <a href="{{ routes.account_url }}" class="link-underline">&larr; {{ 'customer.account.return' | t }}</a>
  <h1 class="h1" style="margin-top:1.6rem;">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p style="opacity:.7;">{{ 'customer.order.date_html' | t: date: order.created_at | date: '%b %d, %Y' }}</p>
  {%- if order.cancelled -%}
    <p class="form__message form__message--error">{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: '%b %d, %Y' }}</p>
  {%- endif -%}

  <div style="overflow-x:auto;margin-top:2.4rem;">
    <table class="size-guide-table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              <a href="{{ line_item.product.url }}" class="link-underline">{{ line_item.title }}</a>
              {%- if line_item.fulfillment %}<br><small style="opacity:.6;">{{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | date: '%b %d, %Y' }}</small>{% endif -%}
            </td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="3">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for discount in order.cart_level_discount_applications -%}
          <tr><td colspan="3">{{ 'customer.order.discount' | t }} ({{ discount.title }})</td><td>−{{ discount.total_allocated_amount | money }}</td></tr>
        {%- endfor -%}
        {%- for shipping in order.shipping_methods -%}
          <tr><td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping.title }})</td><td>{{ shipping.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr><td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>
        {%- endfor -%}
        <tr><td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money }}</strong></td></tr>
      </tfoot>
    </table>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:2.4rem;margin-top:3rem;" class="account-grid">
    <div>
      <h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>
      <div class="rte" style="opacity:.85;">{{ order.shipping_address | format_address }}</div>
    </div>
    <div>
      <h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2>
      <div class="rte" style="opacity:.85;">{{ order.billing_address | format_address }}</div>
    </div>
  </div>
</div>
<style>@media screen and (min-width:750px){.account-grid{grid-template-columns:1fr 1fr;}}</style>

{% schema %}
{
  "name": "Order",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [ { "value": "scheme-1", "label": "Black" }, { "value": "scheme-2", "label": "Bone" } ], "default": "scheme-1" }
  ]
}
{% endschema %}
