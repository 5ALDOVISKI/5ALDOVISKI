{%- comment -%}
  Announcement bar — slim, rotating, linkable messages.
  Merchant can enable/disable (remove the section) and edit each message.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}"
    data-announcement-bar
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.speed | times: 1000 }}">
    <div class="page-width" style="position: relative;">
      {%- if section.blocks.size > 1 -%}
        <button class="announcement-bar__arrow announcement-bar__arrow--prev" data-announcement-prev aria-label="{{ 'sections.announcements.previous_announcement' | t }}">
          {% render 'icon', icon: 'chevron-left', size: 14 %}
        </button>
      {%- endif -%}

      <div class="announcement-bar__slides">
        <div class="announcement-bar__track" data-announcement-track style="display:flex;transition:transform .4s ease;width:100%;">
          {%- for block in section.blocks -%}
            <div class="announcement-bar__slide" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
              {%- else -%}
                <span>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <button class="announcement-bar__arrow announcement-bar__arrow--next" data-announcement-next aria-label="{{ 'sections.announcements.next_announcement' | t }}">
          {% render 'icon', icon: 'chevron-right', size: 14 %}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-4", "label": "Muted red" },
        { "value": "scheme-1", "label": "Black" },
        { "value": "scheme-2", "label": "Bone" },
        { "value": "scheme-3", "label": "Charcoal" }
      ],
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate messages",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "COMPLIMENTARY US SHIPPING ON ORDERS $100+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "COMPLIMENTARY US SHIPPING ON ORDERS $100+" } },
        { "type": "announcement", "settings": { "text": "DROP 001 — AVAILABLE NOW" } },
        { "type": "announcement", "settings": { "text": "JOIN THE MAYDAN" } }
      ]
    }
  ]
}
{% endschema %}
