{%- comment -%} FAQ accordion with FAQPage structured data. {%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    <header class="text-center reveal" style="margin-bottom:3.5rem;">
      {%- if section.settings.overline != blank -%}<p class="overline">{{ section.settings.overline | escape }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading | default: 'FAQ' | escape }}</h1>
    </header>

    <div class="faq-list reveal">
      {%- for block in section.blocks -%}
        <details class="collapsible" {{ block.shopify_attributes }}>
          <summary class="collapsible__summary" style="font-size:1.6rem;">
            {{ block.settings.question | escape }}
            <span class="collapsible__icon">{% render 'icon', icon: 'plus', size: 16 %}</span>
          </summary>
          <div class="collapsible__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [ { "value": "scheme-1", "label": "Black" }, { "value": "scheme-2", "label": "Bone" } ],
      "default": "scheme-1"
    },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does MAYDAN sizing run?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Our gear runs true to size with a compression fit. See the size guide on each product page.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How does MAYDAN sizing run?", "answer": "<p>Our gear runs true to size with a compression fit. Check the size guide on each product page for measurements.</p>" } },
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>US orders ship within 1–2 business days and typically arrive in 3–5 business days.</p>" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>Unworn items with tags can be returned within 30 days. See Shipping & Returns.</p>" } }
      ]
    }
  ]
}
{% endschema %}
